# Jeden adres strony: https, bez www, bez /index.html (301)
RewriteEngine On

# http -> https (home.pl może przekazywać protokół w X-Forwarded-Proto)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://makieta-wirtualna.pl%{REQUEST_URI} [R=301,L]

# www -> bez www
RewriteCond %{HTTP_HOST} ^www\.makieta-wirtualna\.pl$ [NC]
RewriteRule ^ https://makieta-wirtualna.pl%{REQUEST_URI} [R=301,L]

# /index.html -> /, /en/index.html -> /en/, /de/index.html -> /de/
RewriteCond %{THE_REQUEST} \s/((?:en|de)/)?index\.html[\s?] [NC]
RewriteRule ^((?:en|de)/)?index\.html$ /$1 [R=301,L]

# /en -> /en/, /de -> /de/
RewriteRule ^(en|de)$ /$1/ [R=301,L]
