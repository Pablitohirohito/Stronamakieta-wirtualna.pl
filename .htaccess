# Jeden adres strony: https, bez www, bez /index.html (301)
RewriteEngine On

# http -> https (home.pl może przekazywać protokół w X-Forwarded-Proto)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://makieta-wirtualna.pl%{REQUEST_URI} [R=301,L]

# www -> bez www
RewriteCond %{HTTP_HOST} ^www\.makieta-wirtualna\.pl$ [NC]
RewriteRule ^ https://makieta-wirtualna.pl%{REQUEST_URI} [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
